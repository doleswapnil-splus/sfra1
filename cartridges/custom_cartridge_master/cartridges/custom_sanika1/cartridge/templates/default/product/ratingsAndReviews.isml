
<isscript>
var assets = require('*/cartridge/scripts/assets');
assets.addJs('/js/showmore.js'); 
</isscript>

<isif condition="${pdict.ratingsAndReviews}">
<div class="ratings-reviews">

<h2>${Resource.msg('ratings.reviews.title', 'custom', null)} ${pdict.ratingsAndReviews.custom.ProductId}</h2>

<isif condition="${pdict.reviews && pdict.reviews.length > 0}">
    <h3>${Resource.msg('ratings.reviews.heading', 'custom', 'Customer Reviews')}</h3>
    <ul class="reviews-list"> 
        <isset name="totalReviews" value="${pdict.reviews.length}" scope="page"/>
        <isset name="displayCount" value="5" scope="page"/>
        <isloop items="${pdict.reviews.slice(0, displayCount)}" var="review">
            <li class="review-item">
                <h4>${Resource.msg('ratings.reviews.orderId', 'custom', 'Order ID:')} ${review.orderId}</h4>
                <p><strong>${Resource.msg('ratings.reviews.review', 'custom', 'Review:')}</strong> ${review.review}</p>
                <p><strong>${Resource.msg('ratings.reviews.rating', 'custom', 'Rating:')}</strong> ${review.rating}</p>
            </li>
        </isloop>
        <isif condition="${totalReviews > displayCount}">
           
            <button class="show-more" id="showMoreBtn">${Resource.msg('ratings.reviews.showMore', 'custom', 'Show More')}</button>

            <ul class="hidden-reviews" style="display: none;"> 
                <isloop items="${pdict.reviews.slice(displayCount)}" var="additionalReview">
                    <li class="review-item">
                        <h4>${Resource.msg('ratings.reviews.orderId', 'custom', 'Order ID:')} ${additionalReview.orderId}</h4>
                        <p><strong>${Resource.msg('ratings.reviews.review', 'custom', 'Review:')}</strong> ${additionalReview.review}</p>
                        <p><strong>${Resource.msg('ratings.reviews.rating', 'custom', 'Rating:')}</strong> ${additionalReview.rating}</p>
                    </li>
                </isloop>
            </ul>
        </isif>
    </ul>
<iselse>
    <p>${Resource.msg('ratings.reviews.noReviews', 'custom', 'No customer reviews available for this product.')}</p>
</isif>
</div>
<iselse>
<p>${Resource.msg('ratings.reviews.noRatings', 'custom', 'No ratings and reviews found for this product.')}</p>
</isif>
