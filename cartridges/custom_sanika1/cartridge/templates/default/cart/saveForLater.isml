<!-- Save for Later Section -->
<div class="container saved-for-later-section" id="saveForLaterContainer">
    <h2 class="saved-for-later-title text-center">
        ${Resource.msg('title.savedforlater', 'saveForLater', null)}
    </h2>

    <isif condition="${pdict.savedItems.length > 0}">
        <div class="row">
            <isloop items="${pdict.savedItems}" var="savedItem">
                <div class="col-12 saved-item">
                    <div class="row align-items-center saved-item-card p-3 border rounded">
                        <!-- Product Image -->
                        <div class="col-md-2 text-center">
                            <img src="${savedItem.image}" alt="${savedItem.name}" class="img-fluid saved-item-img">
                        </div>

                        <!-- Product Details -->
                        <div class="col-md-6">
                            <h3 class="saved-item-name">${savedItem.name}</h3>
                            <p>${Resource.msg('label.price', 'saveForLater', null)}:${savedItem.price}</p>

                            <!-- Display Variant Attributes -->
                            <isif condition="${savedItem.options && savedItem.options.length > 0}">
                                <ul class="saved-item-options">
                                    <isloop items="${savedItem.options}" var="option">
                                        <li>${option.displayName}: ${option.selectedValue}</li>
                                    </isloop>
                                </ul>
                            </isif>

                            <!-- Gift Certificate Details -->
                            <isif condition="${savedItem.isGiftCertificate && savedItem.giftCertificateType === 'email'}">
                                <div class="gift-certificate-details">
                                    <p>${Resource.msg('giftCertificate.type', 'giftCertificate', null)} ${savedItem.giftCertificateType}</p>
                                    <p>${Resource.msg('giftCertificate.FirstName', 'giftCertificate', null)} ${savedItem.firstName}</p>
                                    <p>${Resource.msg('giftCertificate.LastName', 'giftCertificate', null)}${savedItem.lastName}</p>
                                    <p>${Resource.msg('giftCertificate.email', 'giftCertificate', null)} ${savedItem.email}</p>
                                </div>
                            </isif>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-md-4 text-right d-flex justify-content-end">
                            <button class="btn btn-primary add-to-cart mr-2" data-product-id="${savedItem.productId}">
                                ${Resource.msg('button.addtocart', 'saveForLater', null)}
                            </button>
                            <button class="btn btn-danger remove-saved-item" data-product-id="${savedItem.productId}">
                                ${Resource.msg('button.remove', 'saveForLater', null)}
                            </button>
                        </div>
                    </div>
                    <hr class="my-3">
                </div>
            </isloop>
        </div>
    <iselse/>
        <p class="text-center">${Resource.msg('info.nosaveditems', 'saveForLater', null)}</p>
    </isif>
</div>
