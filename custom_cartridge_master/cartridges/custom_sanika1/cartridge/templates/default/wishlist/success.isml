
<isif condition="${pdict.selectedOptions && pdict.selectedOptions.length > 0}">
    <h3>Selected Options:</h3>
    <ul>
        <isloop items="${pdict.selectedOptions}" var="option">
            <li>
                ${option.optionName}: ${option.optionValue}
            </li>
        </isloop>
    </ul>
</isif>

<div class="wishlist-success-message">
    <p>${pdict.successMessage}</p>
</div>

<isif condition="${pdict.variantProductId}">
    <p>Variant Product ID: ${pdict.variantProductId}</p>
</isif>
